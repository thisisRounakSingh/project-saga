{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://saga.dev/schema/project.saga.json",
  "title": "Saga project file",
  "type": "object",
  "required": ["repo", "generation", "acts", "techStack"],
  "additionalProperties": true,
  "properties": {
    "repo": {
      "type": "object",
      "required": ["name", "url", "totalCommits", "dateRange", "contributors"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "totalCommits": { "type": "number" },
        "dateRange": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        },
        "contributors": { "type": "number" }
      }
    },
    "generation": {
      "type": "object",
      "required": ["model", "generatedAt", "estTokens", "estCostUsd"],
      "properties": {
        "model": { "type": "string" },
        "generatedAt": { "type": "string" },
        "estTokens": { "type": "number" },
        "estCostUsd": { "type": "number" }
      }
    },
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "codename", "dateRange", "commitCount", "narration", "connections", "modules", "qa"],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "number" },
          "codename": { "type": "string" },
          "dateRange": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "string" },
              "end": { "type": "string" }
            }
          },
          "commitCount": { "type": "number" },
          "narration": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["text", "revealed"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "revealed": { "type": "boolean" }
              }
            }
          },
          "keyCommits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["hash", "message", "date"],
              "properties": {
                "hash": { "type": "string" },
                "message": { "type": "string" },
                "date": { "type": "string" }
              }
            }
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "kind"],
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "kind": { "type": "string" }
              }
            }
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "path", "status", "summary"],
              "properties": {
                "name": { "type": "string" },
                "path": { "type": "string" },
                "status": { "type": "string", "enum": ["new", "modified", "deleted", "unchanged"] },
                "linesChanged": { "type": "number" },
                "summary": { "type": "string" }
              }
            }
          },
          "qa": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["question", "answer", "confidence"],
              "properties": {
                "question": { "type": "string", "minLength": 1 },
                "answer": { "type": "string", "minLength": 1 },
                "confidence": { "type": "string", "enum": ["confirmed", "inferred"] },
                "supportingCommits": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "techStack": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "introducedAct"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "introducedAct": { "type": "string" },
          "docsUrl": { "type": "string" }
        }
      }
    }
  }
}
